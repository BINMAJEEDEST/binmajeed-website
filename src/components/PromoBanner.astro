---
import { waLink } from "../data/site";
---
<section class="promo" data-reveal>
  <div class="container">
    <div class="promo-card">
      <div class="promo-text">
        <span class="promo-eyebrow">Business Setup Offer</span>
        <h2>Start your UAE company from AED 4,888*</h2>
        <p>Get a straightforward quote for your trade licence and company formation — no hidden steps, no confusing paperwork.</p>
      </div>
      <div class="promo-action">
        <a href={waLink("Hi, I'd like a quote for company formation starting from AED 4,888.")} class="btn btn-primary" target="_blank" rel="noopener">
          Get My Quote
        </a>
        <span class="promo-fineprint">*Starting price for eligible licence types. Final cost depends on business activity and requirements — ask us for an exact quote.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .promo { padding-top: 0; }
  .promo-card {
    background: var(--bg-navy);
    border-radius: var(--radius-md);
    padding: 44px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    position: relative;
    overflow: hidden;
  }
  .promo-card::before {
    content: "";
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px solid var(--border-on-navy);
  }
  .promo-card::after {
    content: "";
    position: absolute;
    bottom: -90px;
    right: 60px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 1px solid var(--border-on-navy);
  }
  .promo-eyebrow { display: block; color: var(--red-600); font-weight: 600; font-size: 0.85rem; margin-bottom: 10px; }
  .promo-text h2 { color: #fff; margin-bottom: 10px; font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .promo-text p { color: var(--text-on-navy-muted); margin: 0; max-width: 46ch; }
  .promo-action { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; flex-shrink: 0; position: relative; z-index: 1; }
  .promo-fineprint { font-size: 0.72rem; color: var(--text-on-navy-muted); max-width: 26ch; text-align: right; }

  @media (max-width: 820px) {
    .promo-card { flex-direction: column; align-items: flex-start; padding: 36px 28px; }
    .promo-action { align-items: flex-start; }
    .promo-fineprint { text-align: left; }
  }
</style>
