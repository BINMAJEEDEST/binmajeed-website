---
import Faq from "./Faq.astro";
import FinalCta from "./FinalCta.astro";
import { waLink } from "../data/site";

interface SubService { title: string; description: string; }
interface FaqItem { q: string; a: string; }
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  subServices: SubService[];
  faqItems: FaqItem[];
}
const { eyebrow, title, intro, subServices, faqItems } = Astro.props as Props;
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lede">{intro}</p>
    <div class="cta-row">
      <a href={waLink(`Hi, I'd like to ask about ${title}.`)} class="btn btn-primary" target="_blank" rel="noopener">Ask on WhatsApp</a>
      <a href="/contact" class="btn btn-secondary">Request a Quote</a>
    </div>
  </div>
</section>

<section class="section-alt sub-services">
  <div class="container">
    <h2>What's included</h2>
    <div class="sub-list">
      {subServices.map((s) => (
        <div class="sub-item">
          <h3>{s.title}</h3>
          <p>{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="faq-section">
  <div class="container faq-container">
    <span class="eyebrow">Frequently asked</span>
    <h2>Questions about this service</h2>
    <Faq items={faqItems} />
  </div>
</section>

<FinalCta />

<style>
  .page-hero { padding-top: 64px; padding-bottom: 48px; }
  .page-hero .lede { margin: 18px 0 0; }
  .page-hero .cta-row { margin-top: 28px; }

  .sub-services h2 { margin-bottom: 32px; }
  .sub-list { display: flex; flex-direction: column; }
  .sub-item { display: grid; grid-template-columns: 280px 1fr; gap: 32px; padding: 26px 0; border-top: 1px solid var(--border); }
  .sub-item:last-child { border-bottom: 1px solid var(--border); }
  .sub-item h3 { margin-bottom: 0; font-size: 1.05rem; }
  .sub-item p { margin: 0; max-width: 60ch; }

  .faq-container { max-width: 820px; }
  .faq-container h2 { margin-bottom: 32px; }

  @media (max-width: 720px) {
    .sub-item { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
