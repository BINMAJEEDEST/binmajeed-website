---
import { site, services, waLink } from "../data/site";

const currentPath = Astro.url.pathname;
function isActive(path: string) {
  return currentPath === path || currentPath === path + "/";
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} — Home`}>
      <img src="/images/logo-icon.png" alt="" width="40" height="40" class="brand-mark" />
      <span class="brand-name">
        <span class="brand-line1">Bin Majeed</span>
        <span class="brand-line2">Solutions Simplified</span>
      </span>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      <ul>
        <li><a href="/" class:list={{ active: isActive("/") }}>Home</a></li>
        <li><a href="/about" class:list={{ active: isActive("/about") }}>About Us</a></li>
        <li class="has-dropdown">
          <details>
            <summary>
              Services
              <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <ul class="dropdown">
              {services.map((s) => (
                <li><a href={`/${s.slug}`}>{s.title}</a></li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href="/contact" class:list={{ active: isActive("/contact") }}>Contact Us</a></li>
      </ul>

      <div class="nav-actions">
        <a href={site.phoneHref} class="icon-link" aria-label={`Call ${site.name}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <span>{site.phoneDisplay}</span>
        </a>
        <a href={waLink("Hi, I'd like to ask about your services.")} class="icon-link" target="_blank" rel="noopener" aria-label="Message us on WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 4.3A10 10 0 0 0 3.2 16.6L2 21l4.5-1.2A10 10 0 1 0 20 4.3zm-8 16.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-2.7.7.7-2.6-.2-.3A8.3 8.3 0 1 1 12 20.5z" fill="currentColor"/><path d="M16.4 13.4c-.3-.1-1.5-.7-1.8-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1-.7-.3-1.5-.8-2.1-1.5-.5-.5-.9-1.1-1-1.3-.1-.2 0-.4.1-.5.1-.1.3-.3.4-.5.1-.1.2-.3.2-.4.1-.2 0-.4 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.1 2.9.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2-.1-.1-.2-.2-.5-.3z" fill="currentColor"/></svg>
          <span>WhatsApp</span>
        </a>
        <a href="/contact" class="btn btn-primary">Request a Service</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .brand-mark { border-radius: var(--radius-sm); }
  .brand-name { display: flex; flex-direction: column; line-height: 1.2; }
  .brand-line1 { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--text); }
  .brand-line2 { font-size: 0.68rem; color: var(--red-600); letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }

  .primary-nav { display: flex; align-items: center; gap: 32px; flex: 1; justify-content: flex-end; }
  .primary-nav > ul { list-style: none; display: flex; align-items: center; gap: 28px; margin: 0; padding: 0; }
  .primary-nav > ul > li > a {
    display: flex; align-items: center; line-height: 1;
    font-weight: 500; font-size: 0.96rem; color: var(--text);
    padding: 8px 0; border-bottom: 2px solid transparent;
  }
  .primary-nav > ul > li > a:hover,
  .primary-nav > ul > li > a.active { border-bottom-color: var(--red-600); }

  .has-dropdown details { position: relative; }
  .has-dropdown summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; line-height: 1;
    font-weight: 500; font-size: 0.96rem; color: var(--text); padding: 8px 0;
    border-bottom: 2px solid transparent;
  }
  .has-dropdown summary::-webkit-details-marker { display: none; }
  .dropdown {
    list-style: none; margin: 0; padding: 10px; position: absolute; top: calc(100% + 10px); left: -14px;
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius-md);
    min-width: 260px; box-shadow: 0 12px 24px rgba(16, 25, 46, 0.08);
  }
  .dropdown li a { display: block; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.94rem; }
  .dropdown li a:hover { background: var(--bg-alt); }

  .nav-actions { display: flex; align-items: center; gap: 18px; }
  .icon-link { display: flex; align-items: center; gap: 7px; font-size: 0.9rem; font-weight: 500; color: var(--navy-800); }
  .icon-link svg { flex-shrink: 0; }
  .icon-link:hover { color: var(--red-600); }

  .nav-toggle { display: none; flex-direction: column; gap: 4px; background: none; border: none; padding: 6px; cursor: pointer; }
  .nav-toggle-bar { width: 22px; height: 2px; background: var(--text); display: block; }

  @media (max-width: 980px) {
    .icon-link span { display: none; }
  }

  @media (max-width: 860px) {
    .nav-toggle { display: flex; }
    .primary-nav {
      position: fixed; inset: 0; top: 70px;
      background: #fff; flex-direction: column; align-items: stretch; justify-content: flex-start;
      padding: 24px; gap: 24px; overflow-y: auto;
      transform: translateX(100%); transition: transform 0.2s ease;
    }
    .primary-nav.open { transform: translateX(0); }
    .primary-nav > ul { flex-direction: column; gap: 4px; }
    .primary-nav > ul > li > a { display: block; padding: 12px 0; border-bottom: 1px solid var(--border); }
    .has-dropdown summary { padding: 12px 0; border-bottom: 1px solid var(--border); }
    .dropdown { position: static; box-shadow: none; border: none; margin-top: 4px; padding-left: 12px; }
    .nav-actions { flex-direction: column; align-items: stretch; gap: 12px; }
    .icon-link { justify-content: center; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px; }
    .icon-link span { display: inline; }
    .nav-actions .btn { width: 100%; }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
