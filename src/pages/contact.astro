---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site, waLink } from "../data/site";
---
<BaseLayout
  title="Contact Us"
  description="Contact Bin Majeed Documents Clearing Services in Dubai by WhatsApp, phone, email, or the enquiry form below."
  path="/contact"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact Us</span>
      <h1>Tell us what you need — we'll take it from there.</h1>
      <p class="lede">
        Reach us on WhatsApp or by phone during office hours, or fill in the form and we'll get
        back to you using whichever method you prefer.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <div class="block form-block">
        <h2>Send an enquiry</h2>
        <ContactForm />
      </div>

      <aside class="contact-info">
        <div class="info-block">
          <h3>WhatsApp</h3>
          <a href={waLink("Hi, I'd like to ask about your services.")} target="_blank" rel="noopener" class="btn btn-primary btn-block">Message us on WhatsApp</a>
        </div>

        <div class="info-block">
          <h3>Phone</h3>
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </div>

        <div class="info-block">
          <h3>Email</h3>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>

        <div class="info-block">
          <h3>Office</h3>
          <p>{site.address}</p>
          <a href="https://www.google.com/maps/search/?api=1&query=Al+Safiya+Building+Abu+Hail+Dubai" target="_blank" rel="noopener" class="directions-link">Get directions →</a>
        </div>

        <div class="info-block">
          <h3>Hours</h3>
          <p>{site.hours}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="map-section">
    <iframe
      title="Bin Majeed office location"
      src="https://www.google.com/maps?q=Al+Safiya+Building+Abu+Hail+Dubai&output=embed"
      width="100%"
      height="420"
      style="border:0;"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-top: 64px; padding-bottom: 40px; }
  .page-hero .lede { margin-top: 18px; }

  .contact-section { padding-top: 0; padding-bottom: 56px; }
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: start; }
  .form-block h2 { margin-bottom: 24px; }

  .contact-info { display: flex; flex-direction: column; gap: 28px; position: sticky; top: 100px; }
  .info-block h3 { font-size: 0.85rem; text-transform: none; color: var(--text-muted); font-weight: 600; margin-bottom: 8px; }
  .info-block a { color: var(--text); font-weight: 500; }
  .info-block p { margin: 0; }
  .directions-link { display: inline-block; margin-top: 6px; color: var(--red-600); font-weight: 600; font-size: 0.92rem; }

  .map-section { line-height: 0; padding: 0; border-top: 1px solid var(--border); }
  .map-section iframe { display: block; }

  @media (max-width: 920px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-info { position: static; }
  }
</style>
