---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---
<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for Bin Majeed Documents Clearing Services."
  path="/privacy-policy"
>
  <section class="legal-page">
    <div class="container legal-container">
      <span class="eyebrow">Legal</span>
      <h1>Privacy Policy</h1>
      <p class="lede">Last updated: [DATE]</p>

      <p>
        This Privacy Policy explains how {site.name} ("we", "us", "our") collects, uses and
        protects information you provide through this website.
      </p>

      <h2>Information we collect</h2>
      <p>
        When you submit our enquiry form, we collect the information you provide: your name,
        phone/WhatsApp number, email address, the service you're enquiring about, and your
        message. We do not request sensitive personal documents through this website.
      </p>

      <h2>How we use your information</h2>
      <p>
        We use the information you provide solely to respond to your enquiry and, where you
        proceed with a service, to carry out the work you've asked us to do. We do not sell your
        information to third parties.
      </p>

      <h2>How we store your information</h2>
      <p>
        Enquiry form submissions are stored securely by our website hosting provider and are
        accessible only to authorised staff of {site.name}.
      </p>

      <h2>Contact us</h2>
      <p>
        If you have questions about this policy or would like your information removed, contact
        us at <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>

      <p class="legal-note">
        [This page is a starting template. We recommend having it reviewed by a UAE-qualified
        legal advisor before launch to make sure it fully reflects your data-handling practices
        and complies with applicable UAE data protection law.]
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page { padding-top: 64px; padding-bottom: 96px; }
  .legal-container { max-width: 720px; }
  .legal-container h1 { margin-bottom: 6px; }
  .legal-container .lede { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 32px; }
  .legal-container h2 { font-size: 1.15rem; margin-top: 36px; }
  .legal-note { margin-top: 40px; padding: 16px; background: var(--bg-alt); border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.88rem; color: var(--text-muted); max-width: none; }
</style>
