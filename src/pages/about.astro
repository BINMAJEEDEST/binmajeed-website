---
import BaseLayout from "../layouts/BaseLayout.astro";
import FinalCta from "../components/FinalCta.astro";
import { site } from "../data/site";
---
<BaseLayout
  title="About Us"
  description="Bin Majeed Documents Clearing Services supports individuals and companies in Dubai with PRO services, visas and business setup, handled directly with UAE authorities."
  path="/about"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About Us</span>
      <h1>Straightforward help with UAE government paperwork.</h1>
      <p class="lede">
        Bin Majeed Documents Clearing Services has supported individuals and companies in Dubai
        for 3+ years, handling the paperwork side of visas, business setup and government
        transactions so our clients don't have to navigate it alone.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container about-grid">
      <div>
        <h2>What we do</h2>
        <p>
          We handle documents clearing, PRO services, visa and immigration processing, and
          business setup on behalf of our clients — dealing directly with the relevant UAE
          government authorities rather than outsourcing the work to a third party.
        </p>
        <p>
          Our clients range from individuals applying for a family visa to companies that need
          ongoing PRO support for their employees — labour transactions, Emirates ID renewals,
          visa processing and the other recurring paperwork that comes with running a business
          in the UAE.
        </p>
      </div>
      <div>
        <h2>How we work</h2>
        <p>
          Every case starts with a conversation — either on WhatsApp, by phone, or through our
          enquiry form — where we confirm exactly what you need and what documents are required.
          From there, we prepare and submit your paperwork, follow up with the authority on your
          behalf, and keep you updated until the case is closed.
        </p>
        <p>
          We're based in Dubai, near Abu Hail Metro Station, and work with clients across Dubai
          and the wider UAE.
        </p>
      </div>
    </div>
  </section>

  <section class="values">
    <div class="container">
      <span class="eyebrow">How we approach the work</span>
      <h2>What matters to us on every case</h2>
      <div class="grid grid-3">
        <div class="block">
          <h3>Clear communication</h3>
          <p>We explain what's needed and what it costs in plain language, without government jargon.</p>
        </div>
        <div class="block">
          <h3>Direct handling</h3>
          <p>We submit and follow up on your documents ourselves — not through a subcontractor.</p>
        </div>
        <div class="block">
          <h3>Confidentiality</h3>
          <p>Personal and company documents are handled carefully and only shared where required for processing.</p>
        </div>
      </div>
    </div>
  </section>

  <FinalCta
    heading="Have a question before you get started?"
    body="Tell us what you're trying to do and we'll let you know exactly how we can help."
  />
</BaseLayout>

<style>
  .page-hero { padding-top: 64px; padding-bottom: 48px; }
  .page-hero .lede { margin-top: 18px; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .values h2 { margin-bottom: 32px; }
  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
