---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import PromoBanner from "../components/PromoBanner.astro";
import PlatformTeaser from "../components/PlatformTeaser.astro";
import { site, services, waLink } from "../data/site";

const faqItems = [
  {
    q: "What documents do I need to get started?",
    a: "It depends on the service — a visa application, trade licence renewal and labour transaction each need different paperwork. Send us a message with what you're trying to do and we'll confirm exactly what's required for your case.",
  },
  {
    q: "How long does the process usually take?",
    a: "Processing time depends on the service and the government authority involved. Once we understand your case, we'll give you a realistic timeline based on our experience rather than a general estimate.",
  },
  {
    q: "Can you help if I'm not based near your office?",
    a: "Yes. We work with clients across Dubai and the wider UAE, and many steps can be handled remotely — documents can be sent digitally or by courier where the process allows it.",
  },
  {
    q: "Do you work with both individuals and companies?",
    a: "Yes — from a single personal visa application to ongoing PRO support for a company with several employees.",
  },
  {
    q: "How do I start a request?",
    a: "Message us on WhatsApp, call our office, or fill in the enquiry form on this site. We'll ask a few questions about your case and confirm the next step.",
  },
];
---
<BaseLayout
  title="PRO Services, Visa & Business Setup in Dubai & the UAE"
  description="Bin Majeed handles PRO services, visa processing, business setup and government transactions across Dubai and the UAE — with direct follow-up until your case is complete."
  path="/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Documents Clearing &amp; PRO Services · Dubai &amp; Across the UAE</span>
        <h1>Government paperwork across the UAE, handled from start to finish.</h1>
        <p class="lede">
          Bin Majeed manages your visa, trade licence, labour and document clearing requirements
          directly with UAE authorities — from our Dubai office to clients across the UAE —
          and follows up until your case is actually done.
        </p>
        <div class="cta-row">
          <a href={waLink("Hi, I'd like to request a service.")} class="btn btn-primary" target="_blank" rel="noopener">Message us on WhatsApp</a>
          <a href="/contact" class="btn btn-secondary">Request a Quote</a>
        </div>
      </div>
      <div class="hero-panel">
        <div class="step-track">
          <div class="step-item">
            <span class="step-dot">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="step-body">
              <h3>Tell us what you need</h3>
              <p>WhatsApp, call, or the enquiry form.</p>
            </div>
          </div>
          <div class="step-item">
            <span class="step-dot">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12l2 2 4-4M12 3l1.9 1.4 2.3-.4.8 2.2L19 7.5l-.4 2.3L20 12l-1.4 1.9.4 2.3-2.2.8-1 2.1-2.3-.4L12 20l-1.9-1.4-2.3.4-.8-2.2L4.7 16l.4-2.3L4 12l1.4-1.9-.4-2.3 2.2-.8.8-2.2 2.3.4L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="step-body">
              <h3>We confirm the requirements</h3>
              <p>Documents, fees and realistic timing.</p>
            </div>
          </div>
          <div class="step-item">
            <span class="step-dot">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="step-body">
              <h3>We handle it with the authority</h3>
              <p>Submission and follow-up, direct.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PromoBanner />

  <!-- Trust bar -->
  <section class="trust-bar section-alt">
    <div class="container trust-grid" data-reveal-group>
      <div class="trust-item">
        <span class="trust-figure">3+ yrs</span>
        <span class="trust-label">Serving clients across the UAE</span>
      </div>
      <div class="trust-item">
        <span class="trust-figure">5</span>
        <span class="trust-label">Service categories, one office</span>
      </div>
      <div class="trust-item">
        <span class="trust-figure">Direct</span>
        <span class="trust-label">Submission to government authorities</span>
      </div>
      <div class="trust-item">
        <a href="https://www.google.com/maps/search/?api=1&query=Bin+Majeed+Documents+Clearing+Services+Dubai" target="_blank" rel="noopener" class="trust-figure trust-link">
          Read our reviews on Google →
        </a>
        <span class="trust-label">See what past clients say</span>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services">
    <div class="container">
      <span class="eyebrow">What we handle</span>
      <h2>Services built around what you're trying to get done</h2>
      <div class="grid grid-3 services-grid" data-reveal-group>
        {services.map((s) => (
          <a href={`/${s.slug}`} class="block service-card">
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <span class="service-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <PlatformTeaser />

  <!-- Why choose us -->
  <section class="section-alt why-us">
    <div class="container why-us-grid">
      <div>
        <span class="eyebrow">Why clients work with us</span>
        <h2>Real follow-up, not just a submission stamp</h2>
        <p class="lede">A lot of clearing services stop at dropping off your paperwork. Ours doesn't.</p>
      </div>
      <div class="grid grid-2 why-us-list" data-reveal-group>
        <div class="block">
          <h3>We deal with the authority directly</h3>
          <p>Submissions and follow-up are handled by our own team, not passed to a third party.</p>
        </div>
        <div class="block">
          <h3>Everything under one roof</h3>
          <p>PRO services, visas, business setup and labour transactions — no need to juggle separate providers.</p>
        </div>
        <div class="block">
          <h3>Straightforward communication</h3>
          <p>We tell you what's needed, what it costs, and where your case stands — in plain language.</p>
        </div>
        <div class="block">
          <h3>Based locally in Dubai</h3>
          <p>Our office near Abu Hail Metro Station is easy to reach for document handover and collection.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas served -->
  <section class="areas">
    <div class="container areas-grid">
      <div>
        <span class="eyebrow">Areas served</span>
        <h2>Based in Dubai, serving clients across the UAE</h2>
        <p>
          Our office is in Dubai, near Abu Hail Metro Station, and we support individuals and
          companies across the UAE — including cases that involve federal authorities such as
          MOHRE and UAE immigration, wherever in the country you're based.
        </p>
      </div>
      <div class="areas-panel block">
        <h3>Who we typically work with</h3>
        <ul class="areas-list">
          <li>Individuals and families across the UAE</li>
          <li>Companies and HR teams across the UAE</li>
          <li>Cases involving Dubai and UAE federal authorities</li>
          <li>Clients outside Dubai, supported remotely</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-alt faq-section">
    <div class="container faq-container">
      <span class="eyebrow">Frequently asked</span>
      <h2>Common questions</h2>
      <Faq items={faqItems} />
    </div>
  </section>

  <FinalCta />
</BaseLayout>

<style>
  .hero { padding-top: 72px; padding-bottom: 72px; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 0.9fr; gap: 56px; align-items: start; }
  .hero-panel {
    border-radius: var(--radius-lg); padding: 12px 8px;
    background: linear-gradient(165deg, #FFFFFF 0%, var(--bg-alt) 100%);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lift);
  }
  .step-track { position: relative; padding: 8px 0; }
  .step-track::before {
    content: ""; position: absolute; left: 39px; top: 44px; bottom: 44px; width: 2px;
    background: linear-gradient(var(--border), var(--border)); background-size: 2px 10px; background-repeat: repeat-y;
    opacity: 0.9;
  }
  .step-item { display: flex; gap: 18px; align-items: flex-start; padding: 18px 22px; position: relative; }
  .step-dot {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%;
    background: var(--navy-900); color: #fff; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 14px rgba(16,25,46,0.28), inset 0 1px 0 rgba(255,255,255,0.15);
    position: relative; z-index: 1;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .step-item:hover .step-dot { background: var(--red-600); transform: scale(1.08); }
  .step-body h3 { font-size: 1rem; margin-bottom: 4px; }
  .step-body p { font-size: 0.9rem; margin: 0; }

  .trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .trust-item { display: flex; flex-direction: column; gap: 6px; }
  .trust-figure { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; color: var(--navy-900); }
  .trust-link { font-size: 1.05rem; color: var(--red-600); }
  .trust-label { font-size: 0.88rem; color: var(--text-muted); }

  .services-grid { margin-top: 40px; }
  .service-card { display: flex; flex-direction: column; gap: 10px; }
  .service-card h3 { margin-bottom: 0; }
  .service-card p { font-size: 0.94rem; margin-bottom: 4px; }
  .service-link { font-size: 0.9rem; font-weight: 600; color: var(--red-600); }
  .service-card:hover { border-color: var(--navy-600); transform: translateY(-4px); box-shadow: var(--shadow-lift); }

  .why-us-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 48px; align-items: start; }
  .why-us-list { margin-top: 0; }

  .areas-grid { display: grid; grid-template-columns: 1fr 0.75fr; gap: 48px; align-items: start; }
  .areas-panel h3 { font-size: 0.95rem; margin-bottom: 16px; }
  .areas-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .areas-list li { position: relative; padding-left: 18px; font-size: 0.94rem; color: var(--text-muted); }
  .areas-list li::before { content: ""; position: absolute; left: 0; top: 9px; width: 6px; height: 6px; background: var(--red-600); }
  @media (max-width: 780px) {
    .areas-grid { grid-template-columns: 1fr; }
  }

  .faq-container { max-width: 820px; }
  .faq-container h2 { margin-bottom: 32px; }

  @media (max-width: 920px) {
    .hero-grid, .why-us-grid { grid-template-columns: 1fr; }
    .trust-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
